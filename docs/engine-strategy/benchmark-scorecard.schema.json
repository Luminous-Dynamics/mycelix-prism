{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prism Browser Benchmark Scorecard",
  "description": "Benchmark protocol and staged targets. This is not a result report.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reviewed_at",
    "decision",
    "measurement_protocol",
    "suites"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date"
    },
    "decision": {
      "type": "string",
      "minLength": 1
    },
    "measurement_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warmup_runs",
        "measured_runs",
        "minimum_baseline_samples_for_regression_gates",
        "report_statistics",
        "cold_run_rule",
        "environment_capture",
        "regression_policy",
        "comparison_policy",
        "result_policy",
        "privacy_policy",
        "minimum_paired_blocks_for_regression_gates",
        "comparison_design",
        "drift_policy"
      ],
      "properties": {
        "warmup_runs": {
          "type": "integer"
        },
        "measured_runs": {
          "type": "integer"
        },
        "minimum_baseline_samples_for_regression_gates": {
          "type": "integer"
        },
        "report_statistics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "cold_run_rule": {
          "type": "string",
          "minLength": 1
        },
        "environment_capture": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "regression_policy": {
          "type": "string",
          "minLength": 1
        },
        "comparison_policy": {
          "type": "string",
          "minLength": 1
        },
        "result_policy": {
          "type": "string",
          "minLength": 1
        },
        "privacy_policy": {
          "type": "string",
          "minLength": 1
        },
        "minimum_paired_blocks_for_regression_gates": {
          "type": "integer",
          "minimum": 30
        },
        "comparison_design": {
          "type": "string",
          "minLength": 1
        },
        "drift_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "suites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "class",
          "source",
          "readiness",
          "priority",
          "status",
          "metrics",
          "method",
          "notes",
          "references"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "class": {
            "enum": [
              "correctness",
              "conformance",
              "security",
              "privacy",
              "performance",
              "resource",
              "reliability",
              "industry-comparator"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "readiness": {
            "enum": [
              "ci_now",
              "blocked_until_wpt_manifest_pinned",
              "blocked_until_ladybird_vertical_slice",
              "blocked_until_interactive_runtime",
              "blocked_until_host_integration",
              "blocked_until_fixture_runner",
              "blocked_until_page_javascript_and_required_web_apis",
              "blocked_until_javascript_and_wasm_runtime",
              "blocked_until_supported_graphics_and_animation_apis"
            ]
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "status": {
            "enum": [
              "protocol_only",
              "not_applicable_yet"
            ]
          },
          "metrics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "metric_id",
                "direction",
                "target_value",
                "unit",
                "target_stage",
                "target_basis",
                "gate_when_activated",
                "pass_condition"
              ],
              "properties": {
                "metric_id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]*$"
                },
                "direction": {
                  "enum": [
                    "lower_is_better",
                    "higher_is_better",
                    "must_equal",
                    "baseline_only"
                  ]
                },
                "target_value": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "target_stage": {
                  "enum": [
                    "provisional",
                    "activation_gate",
                    "baseline_only"
                  ]
                },
                "target_basis": {
                  "enum": [
                    "absolute_budget",
                    "zero_tolerance",
                    "relative_to_baseline",
                    "correctness_contract",
                    "none_until_support"
                  ]
                },
                "pass_condition": {
                  "type": "string",
                  "minLength": 1
                },
                "gate_when_activated": {
                  "type": "boolean"
                }
              }
            }
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string",
            "minLength": 1
          },
          "references": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      }
    }
  }
}
