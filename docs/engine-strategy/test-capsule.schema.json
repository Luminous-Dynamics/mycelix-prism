{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prism Reproducible Browser Test Result Capsule",
  "description": "Exact-revision test-run evidence. It records every manifest case and separates behavioral outcomes from provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prism_revision",
    "engine_id",
    "engine_revision",
    "capability_ids",
    "suite",
    "suite_revision",
    "manifest_sha256",
    "manifest_case_count",
    "environment",
    "command",
    "generated_at_utc",
    "cases",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "prism_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "engine_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "engine_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "capability_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      }
    },
    "suite": {
      "enum": [
        "prism_fixture",
        "web_platform_tests",
        "render_smoke",
        "browser_security",
        "performance"
      ]
    },
    "suite_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifest_case_count": {
      "type": "integer"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "architecture",
        "runner_image",
        "toolchain",
        "toolchain_lock_sha256",
        "gpu_backend"
      ],
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "runner_image": {
          "type": "string",
          "minLength": 1
        },
        "toolchain": {
          "type": "string",
          "minLength": 1
        },
        "toolchain_lock_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "gpu_backend": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "generated_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "input_sha256",
          "expectation_ref",
          "outcome",
          "actual_sha256",
          "duration_ms"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._/-]+$",
            "minLength": 1
          },
          "input_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "expectation_ref": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "enum": [
              "passed",
              "failed",
              "timeout",
              "unsupported",
              "skipped",
              "not_run"
            ]
          },
          "actual_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "duration_ms": {
            "type": "integer"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "failed",
        "timeout",
        "unsupported",
        "skipped",
        "not_run",
        "total"
      ],
      "properties": {
        "passed": {
          "type": "integer"
        },
        "failed": {
          "type": "integer"
        },
        "timeout": {
          "type": "integer"
        },
        "unsupported": {
          "type": "integer"
        },
        "skipped": {
          "type": "integer"
        },
        "not_run": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        }
      }
    }
  }
}
